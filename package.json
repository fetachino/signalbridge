{
  "name": "signalbridge",
  "private": true,
  "version": "0.1.0",
  "author": "Ahmed Balde (fetachino)",
  "description": "Accessibility-first Fire TV prototype for turning broadcast alerts into clear spoken and visual guidance.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "package:firetv": "npm run build && node scripts/package-firetv.mjs",
    "check:firetv": "node scripts/check-firetv-env.mjs"
  },
  "keywords": [
    "fire-tv",
    "vega",
    "accessibility",
    "computer-vision",
    "react",
    "typescript"
  ],
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^7.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
